# ==============================================================================
# SIH26018 — Intelligent Land Record Digitization and Validation System
# Configuration & API Credentials (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER CREDENTIALS (For High-Accuracy Document Field Extraction)
# ------------------------------------------------------------------------------
# Provide either an OpenAI API Key or a Google Gemini API Key.
# The system automatically detects and uses whichever key is configured!

# OpenAI API Key (starts with sk-...)
OPENAI_API_KEY=

# OpenAI Model to use (gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (starts with AIzaSy...)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. SYSTEM OPERATION MODES
# ------------------------------------------------------------------------------
ENVIRONMENT=development
MOCK_MODE=false
DEMO_MODE=true
DEBUG=true

# ------------------------------------------------------------------------------
# 3. OCR ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: RAPIDOCR (Offline Deep Learning ONNX engine for images/scanned PDFs)
OCR_PROVIDER=RAPIDOCR

# ------------------------------------------------------------------------------
# 4. DATABASE & JWT SECURITY
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./land_records.db
JWT_SECRET_KEY=sih26018-super-secret-key-dolr-smart-land-records-2026-prod
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ------------------------------------------------------------------------------
# 5. SPATIAL GIS & GOOGLE MAPS (Optional for Cadastral Maps)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_STREET_VIEW_API_KEY=
