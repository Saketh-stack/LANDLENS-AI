# ==========================================================
# SIH26018 — Intelligent Land Record Digitization and Validation
# Environment Configuration (.env)
# ==========================================================

# Database Configuration (PostgreSQL Ready / SQLite fallback)
DATABASE_URL=sqlite:///./land_records.db
# For PostgreSQL production:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/land_records

# Security & JWT Authentication
JWT_SECRET_KEY=sih26018-super-secret-key-dolr-smart-land-records-2026-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI / LLM Integration (OpenAI or local fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Maps & Spatial GIS Integration
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_STREET_VIEW_API_KEY=

# OCR Provider Configuration (TESSERACT, PADDLEOCR, EASYOCR, MOCK)
OCR_PROVIDER=MOCK
OCR_API_KEY=

# Document Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=uploads
UPLOAD_DIR=uploads

# System Mode Flags
ENVIRONMENT=development
MOCK_MODE=true
DEMO_MODE=true
DEBUG=true
